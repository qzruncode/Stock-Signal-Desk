# Independent service only; never point this at the business database.
MARKET_DATA_DATABASE_URL=postgresql+psycopg://market_data:CHANGE_ME@127.0.0.1:5433/market_data
MARKET_DATA_BROKER_URL=redis://127.0.0.1:6381/0
# Production / Compose: set a random token of at least 32 characters.
MARKET_DATA_API_TOKEN=
# Compose only. Use a separate random URL-safe password, not the API token.
MARKET_DATA_DB_PASSWORD=
MARKET_DATA_ENVIRONMENT=development
MARKET_DATA_PROVIDER=live
MARKET_DATA_RSSHUB_URL=http://127.0.0.1:1200
# Business environment (.env):
# MARKET_DATA_SERVICE_URL=http://127.0.0.1:8010
# MARKET_DATA_SERVICE_TOKEN=<same token as MARKET_DATA_API_TOKEN>
