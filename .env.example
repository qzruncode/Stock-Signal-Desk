# ===================================
# A股自选股智能分析系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实配置
# ===================================

# 自选股列表（逗号分隔，支持沪深两市代码）
# 沪市：600xxx, 601xxx, 603xxx
# 深市：000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# 数据源配置
# Tushare Pro Token（可选，从 https://tushare.pro/weborder/#/login?reg=834638 获取）
TUSHARE_TOKEN=
# TickFlow API Key（可选，用于 A 股大盘复盘指数增强；若套餐支持标的池查询，也可增强市场统计）
# TICKFLOW_API_KEY=

# Finnhub（可选，美股数据源，免费 tier 60 calls/min）
# 获取: https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage（可选，美股数据源，免费 tier 25 calls/day）
# 获取: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI（可选，美股/港股量比、换手率、PE 等字段兜底）
# 从 https://open.longbridge.com/ 获取
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info 进程内缓存秒数，默认 86400；0=每次请求拉取
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# 连接关闭类异常后的冷却秒数，默认 15；冷却期内会临时跳过 Longbridge，避免请求级频繁重连
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# Longbridge SDK 语言与 REPORT_LANGUAGE（zh/en）一致；SDK 日志写入 LOG_DIR/longbridge_sdk.log
# 接入点（与 REPORT_LANGUAGE 无关；留空则用下列默认值）：
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# 覆盖接入点；SDK 内部用 LONGPORT_REGION（不带 BRIDGE）自动选择，
# 代码会自动同步 LONGBRIDGE_REGION → LONGPORT_REGION。
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# 其余见：https://open.longbridge.com/zh-CN/docs/getting-started#环境变量
# 夜盘行情 true/false，默认 false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# K 线推送 realtime 或 confirmed，默认 realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# 连接时是否打印行情包（与 README / full-guide 一致：未设置时应用侧默认为关闭，等同 false）
# 设为 1 / true / yes 开启 SDK 详细行情包日志（调试长桥连接时使用）
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# ===================================
# AI 模型配置（Anthropic 网关单源）
# ===================================
# 本项目聊天模型调用（个股分析 / 市场主线 / 股票解析 / AI 助手）统一通过
# Anthropic 网关接入。在 Web「设置 - 模型设置」页填入以下三项即可，亦可在此 .env 配置。
# 三者任一缺失，AI 分析与 AI 助手将不可用（硬性报错，不回落到其他来源）。
#
# 网关地址可以是 Anthropic 官方、Claude Code 兼容服务或第三方中转/代理。
# ===================================

# --- Anthropic 网关（必填）---

# 接入地址（Anthropic 官方留空即可；中转/代理填其 base url）
ANTHROPIC_BASE_URL=

# 鉴权令牌（ANTHROPIC_AUTH_TOKEN，对应网关的 API Key / Bearer Token）
ANTHROPIC_AUTH_TOKEN=

# 主模型（如 claude-sonnet-4-6；可带 [1m] 后缀表示 1M 上下文窗口）
ANTHROPIC_MODEL=claude-sonnet-4-6

# Auto 默认选择 Direct / Plan / Team；Goal 可由用户显式选择。
# 只有验证部署稳定后，才开启 Auto 自动选择 Goal：
# AGENT_GOAL_AUTO_ROUTING_ENABLED=false

# --- PDF 知识库 RAG 本机开源模型服务（由 scripts/rag-local.sh 管理）---
# Qdrant FastEmbed CPU/ONNX；本机运行，不依赖 Ollama、公司模型网关或 Docker。
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8081
RAG_EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_MODEL_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
RAG_VECTOR_DIMENSION=384
RAG_RERANK_BASE_URL=http://127.0.0.1:8082
RAG_RERANK_MODEL_ID=BAAI/bge-reranker-base
RAG_RERANK_MODEL_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
# 混合检索仍召回 30 条；为保证本机 CPU 交互延迟，BGE 精排默认最多计算前 12 条。
RAG_RERANK_CANDIDATE_LIMIT=12
# 留空时自动复用 OpenViking / Hugging Face 本地模型缓存；也可显式填模型快照目录。
RAG_RERANK_MODEL_PATH=
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_TIMEOUT_SECONDS=10
RAG_CELERY_BROKER_URL=redis://127.0.0.1:6382/0
RAG_STORAGE_PATH=./data/rag
# Worker 命令行 concurrency 上限；生产环境按 CPU/GPU、模型服务吞吐、解析内存与磁盘容量调整。
RAG_WORKER_CONCURRENCY=1

# Claude Code 槽位默认模型（可选，用于 Claude Code 兼容服务）
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000

# --- 生成参数（可选，正交于网关配置）---

# 采样温度（0.0-2.0，默认 0.7；0 确定性最高，2 随机性最高）
# LLM_TEMPERATURE=0.7

# 思考模式（thinking）：开启后支持模型输出更深的推理链
# LLM_THINKING_ENABLED=false

# 推理深度（仅 thinking 开启时生效；auto 用供应商默认）
# LLM_REASONING_EFFORT=auto

# 其他模型和 fallback 仍使用你配置的 LLM_TEMPERATURE。
# Web 设置页 / 桌面端导入不会静默清空或改写 LLM_TEMPERATURE；只在真正发请求前临时适配模型参数。
# 如果主模型切回普通模型，原本配置的温度会自动恢复；最小回滚方式是回退本次 LLM 参数适配改动。
# LLM_TEMPERATURE=0.7

# ===================================
# 通用网页搜索配置
# ===================================
# `search_web_source` / `read_web_source` 可使用的可选上游凭据。
# 模型每轮都能看到完整来源目录，并自行选择 source_id；每次原子调用只访问一个来源，
# 服务端不会在来源之间静默串成固定兜底链路。
# 获取: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Parallel 只在模型明确选择对应 source_id 时调用
PARALLEL_API_KEY=

# Firecrawl 和 SearXNG 是项目内置的候选来源，由 ./dev.sh 自动启动，无需配置地址或 Key。
# 安全默认禁止 Agent 抓取 localhost/内网地址；仅明确的内网部署场景开启
# WEBFETCH_ALLOW_PRIVATE=false

# ===================================
# 新闻时效与分析筛选配置
# ===================================
# 新闻策略窗口档位：ultra_short(1天) / short(3天) / medium(7天) / long(30天)
# 实际窗口 = min(策略窗口, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# 新闻最大时效（天），搜索时限制结果在近期内，避免使用过时信息
# NEWS_MAX_AGE_DAYS=3
# 乖离率阈值（%），偏离 MA5 超过此值提示不追高；强势趋势股自动放宽到 1.5 倍
# BIAS_THRESHOLD=5.0

# ===================================
# 通知渠道配置（仅企业微信）
# ===================================
#
# 企业微信机器人 Webhook 地址
# 在企业微信群 -> 设置 -> 群机器人 -> 添加 -> 复制 Webhook 地址
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
#
# 【高级配置】消息长度限制（字节）
# 企业微信 Markdown 限制 4096 字节，默认 4000 字节
# WECHAT_MAX_BYTES=4000

# 报告输出语言：zh(中文，默认) / en(英文)
# REPORT_LANGUAGE=zh

DATABASE_PATH=./data/stock_analysis.db
# SQLite 写入优化：文件库默认启用 WAL，降低批量写入和并发回写时的锁竞争
SQLITE_WAL_ENABLED=true
# SQLite 等锁超时（毫秒）
SQLITE_BUSY_TIMEOUT_MS=5000
# SQLite 遇到 database is locked / database table is locked 时的最大重试次数
SQLITE_WRITE_RETRY_MAX=3
# SQLite 写入重试基础退避时间（秒，按指数退避递增）
SQLITE_WRITE_RETRY_BASE_DELAY=0.1
# ===================================
# 代理配置（可选）
# ===================================
# 是否启用代理（true/false，默认 false）
# 仅在本地开发环境生效，GitHub Actions 环境自动跳过
USE_PROXY=false
# 代理服务器地址（默认 127.0.0.1）
PROXY_HOST=127.0.0.1
# 代理服务器端口（默认 10809）
PROXY_PORT=10809

# 系统配置
# 日志目录
LOG_DIR=./logs
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
# LiteLLM 内部日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL；默认 WARNING；排查内部流式/路由细节时可临时设为 DEBUG）
# LITELLM_LOG_LEVEL=WARNING
# 是否启用调试日志
DEBUG=false

# ===================================
# WebUI 配置（可选）
# ===================================
# 独立数据服务：业务仅通过服务 API 读取，不共享数据服务数据库。
# 生产环境 TOKEN 必须与数据服务 MARKET_DATA_API_TOKEN 一致。
MARKET_DATA_SERVICE_URL=http://127.0.0.1:8010
MARKET_DATA_SERVICE_TOKEN=

# 是否默认启动 WebUI（true/false，默认 false）
WEBUI_ENABLED=false
# WebUI 监听地址（默认 127.0.0.1；生产环境建议只监听反向代理可达地址，详见 AI_ASSISTANT_PRODUCTION.md）
WEBUI_HOST=127.0.0.1
# WebUI 监听端口（默认 8000）
WEBUI_PORT=8000
# 启动 Web 服务前是否自动构建前端（npm install && npm run build，默认 true）
WEBUI_AUTO_BUILD=true
# 单层可信反向代理（如 Nginx → App）下信任 X-Forwarded-For 获取真实 IP，取最右值用于登录限流；多级代理/CDN 场景限流 key 可能退化为边缘代理 IP，需额外评估；直连公网时保持 false 防伪造
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Web 登录认证（可选）
# ===================================
# 设为 true 启用密码保护；首次访问时在网页设置初始密码，可在「系统设置 > 修改密码」中修改
# 忘记密码可在服务器执行: python -m src.auth reset_password
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # Session 有效期（小时）

# ===================================
# AI 助手生产运行门禁
# ===================================
# 生产部署必须设为 production（或 DSA_PRODUCTION=true）；启动时会执行 fail-closed 预检。
# APP_ENV=production
# DSA_PRODUCTION=true
# 生产数据库必须使用 PostgreSQL；应用 worker 默认只校验版本，不执行 DDL。
# DATABASE_URL=postgresql+psycopg://agent:replace-me@postgres:5432/agent
# DATABASE_AUTO_MIGRATE=false
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=30
# DATABASE_POOL_RECYCLE_SECONDS=1800
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_LOCK_TIMEOUT_MS=5000
# 可横向扩容；run、step、事件、取消与资源租约均由数据库协调。
# WEB_CONCURRENCY=3
# UVICORN_WORKERS=3
# 全部署同时运行的 AI 助手任务数（1-64，默认 4）
# AGENT_MAX_ACTIVE_RUNS=4
# 单个租户用户可占用的并发 Run，防止一个主体耗尽全局容量。
# AGENT_MAX_ACTIVE_RUNS_PER_OWNER=2
# 每个租户用户与来源 IP 组合每分钟最多启动的任务；生产环境必须大于 0。
# AGENT_REQUESTS_PER_MINUTE=30
# 单次请求历史与体积上限
# AGENT_MAX_MESSAGES=100
# AGENT_MAX_MESSAGE_CHARS=100000
# AGENT_MAX_REQUEST_CHARS=1000000
# Agent 受工具调用量、Token 和成本预算约束；普通 Agent 的模型思考与整轮分析不设置本地时限。
# AGENT_MAX_TOOL_CALLS=1000
# AGENT_MAX_PROVIDER_CALLS=64
# AGENT_MAX_ESTIMATED_TOKENS=1000000
# AGENT_MAX_ESTIMATED_COST_MICROS=5000000
# 模型/Tool 的共享容量、有限重试和估算单价。
# AGENT_PROVIDER_MAX_ATTEMPTS=2
# AGENT_PROVIDER_RETRY_BACKOFF_SECONDS=0.5
# AGENT_PROVIDER_GLOBAL_CONCURRENCY=4
# 每个 `tool:{tool_name}` DB 资源池的容量；只读调用走 LangGraph 原生 handler，不使用该门禁。
# AGENT_TOOL_RESOURCE_CONCURRENCY=8
# 旧配置名仍作为兼容回退，不建议新部署继续使用。
# AGENT_TOOL_GLOBAL_CONCURRENCY=8
# AGENT_ESTIMATED_MICROS_PER_1K_TOKENS=5000
# 候选回答中的引用会做逐条事实—证据机械审计；失败时由同一模型循环修订，
# 不启动第二个 Planner、固定 Workflow 或独立验证模型。该值仅限制修订轮次，不是分析时限。
# AGENT_EVIDENCE_REPAIR_LIMIT=2
# 长对话使用 LangChain 原生摘要，保留最近 20 条消息和独立证据账本。
# 0 关闭；未配置时按模型窗口动态计算，200k 窗口默认约 60000 Token 触发。
# AGENT_SUMMARY_TRIGGER_TOKENS=60000
# 可改为 Token 保留量；未配置时按消息数量保留。摘要输入按模型窗口自动留出
# 输出、提示词和安全余量，并同时保留被淘汰片段的开头与结尾。
# AGENT_SUMMARY_KEEP_TOKENS=12000
# AGENT_SUMMARY_KEEP_MESSAGES=20
# 可进一步收紧摘要模型输入；0 或留空表示使用上述模型窗口预算。
# AGENT_SUMMARY_TRIM_TOKENS=0
# 摘要提示词额外预留量；用于避免摘要调用本身逼近模型上限。
# AGENT_SUMMARY_PROMPT_RESERVE_TOKENS=2048
# 模型请求的上下文预算：输出预留和安全余量不会发送给输入上下文。
# AGENT_CONTEXT_WINDOW_TOKENS=200000
# AGENT_CONTEXT_OUTPUT_TOKENS=8000
# AGENT_CONTEXT_SAFETY_TOKENS=4096
# 结构化回答格式不满足时的有限修订轮次；耗尽后发布一次可解释的 partial 结果。
# AGENT_RESPONSE_REPAIR_LIMIT=1
# 每个失败外部来源的恢复回合上限：默认搜索后读取正文，仍计入工具总预算；0 关闭恢复。
# AGENT_SOURCE_FALLBACK_REPAIR_LIMIT=2
# 崩溃接管与有界保留。
# AGENT_RECOVERY_INTERVAL_SECONDS=15
# AGENT_RUN_RETENTION_DAYS=7
# AGENT_RETENTION_INTERVAL_SECONDS=3600
# 生产必须隔离全部无状态 Tool。
# AGENT_ISOLATE_ALL_STATELESS=true
# 使用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
# AGENT_TRACE_ENCRYPTION_KEY=
# AGENT_TRACE_RETENTION_DAYS=7
# 多租户部署只接受可信反向代理覆盖的身份头。
# AGENT_MULTI_TENANT_ENABLED=false
# TRUSTED_IDENTITY_HEADERS=false
# TRUSTED_PROXY_IDENTITY=false
# TRUSTED_IDENTITY_SHARED_SECRET=replace-with-at-least-32-random-characters
# Agent 使用唯一的 LangChain create_agent / LangGraph 持久消息—工具循环，
# 没有按意图选择的模板、固定业务 DAG 或运行时回退模式。
# 生产环境不得启用 CORS_ALLOW_ALL 或 WEBFETCH_ALLOW_PRIVATE。
# CORS_ORIGINS=https://stocks.example.com
# CORS_ALLOW_ALL=false
# WEBFETCH_ALLOW_PRIVATE=false

# ===========================================
# Data Fetcher Priority Configuration
# ===========================================
# Lower number = higher priority (tried first)
# Default priorities: efinance(0) > akshare(1) > tushare/pytdx(2) > baostock(3) > yfinance(4)
# For US stocks, set YFINANCE_PRIORITY=0 to use Yahoo Finance first

# EFINANCE_PRIORITY=0      # EastMoney (China) - default: 0
# EFINANCE_CALL_TIMEOUT=30 # Timeout (seconds) for efinance API calls; prevents indefinite hangs
#                          # when eastmoney hosts are unreachable. Default: 30
# AKSHARE_PRIORITY=1       # AkShare (China) - default: 1
# TUSHARE_PRIORITY=2       # Tushare Pro (China) - default: 2
# PYTDX_PRIORITY=2         # Tongdaxin (China) - default: 2
#
# Pytdx custom server (for intranet/deploy): use custom host instead of built-in public servers
# PYTDX_HOST=192.168.1.100
# PYTDX_PORT=7709
# Or multiple servers: PYTDX_SERVERS=ip1:port1,ip2:port2
# BAOSTOCK_PRIORITY=3      # Baostock (China) - default: 3
# YFINANCE_PRIORITY=4      # Yahoo Finance (Global) - default: 4

# Example: Prioritize Yahoo Finance for US stocks
# YFINANCE_PRIORITY=0
# EFINANCE_PRIORITY=99

# ===========================================
# 实时行情数据源优先级配置
# ===========================================
# 用于获取量比、换手率、市盈率等实时数据
# 可选数据源（逗号分隔，按顺序尝试）：
#   - tencent: 腾讯财经，有量比/换手率/PE/PB，单股查询稳定（推荐首选）
#   - akshare_sina: 新浪财经，基本行情，无量比，但非常稳定
#   - efinance: 东财(efinance库)，有量比，全量拉取易被封
#   - akshare_em: 东财(akshare库)，数据最全，全量拉取易被封
#   - tushare: Tushare Pro，需要2000积分，数据全面（付费用户推荐）
#
# 默认优先级：tencent > akshare_sina > efinance > akshare_em
# 如果有 Tushare Pro 高积分账号，可将 tushare 放在首位：
# REALTIME_SOURCE_PRIORITY=tushare,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# 是否启用实时行情（关闭后使用历史收盘价分析）
# ENABLE_REALTIME_QUOTE=true

# 盘中实时技术面：启用时用实时价计算 MA/多头排列（Issue #234）；关闭则用昨日收盘
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# 是否启用筹码分布（该接口不稳定，云端部署建议关闭）
# ENABLE_CHIP_DISTRIBUTION=true

# 是否启用基本面聚合（新增 P0 能力）
# ENABLE_FUNDAMENTAL_PIPELINE=true

# 基本面聚合性能与稳定性参数（单位：秒）
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=3.0
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===================================
# RSS 配置（可选）
# ===================================
# RSSHub 实例地址（默认使用当前项目自建实例）
# dev.sh 启动时复用/启动 services/rsshub；停止业务不会停止数据服务和 RSSHub
# 手动启动：cd services/rsshub && npm install --engine-strict=false && npm start
# RSSHUB_BASE_URL=http://127.0.0.1:1200
#
# PDF 内联渲染代理白名单（逗号分隔 host）。RSS item 详情里 PDF 报告通过同源
